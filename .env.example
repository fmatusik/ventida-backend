# Baza danych (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ventida"
DIRECT_URL="postgresql://user:password@localhost:5432/ventida"

# WYMAGANE: min. 32 znaki. Wygeneruj: openssl rand -hex 32
JWT_SECRET=""
# Ważność tokenu (domyślnie 12h)
# JWT_EXPIRES_IN="12h"

# Adres(y) frontendu dopuszczone przez CORS, po przecinku
FRONTEND_URL="http://localhost:3000"

# Za reverse proxy (nginx, Render, Heroku...) ustaw liczbę proxy, by rate limit widział prawdziwe IP
# TRUST_PROXY=1

PORT=6969

# Tylko do testów e2e (osobna baza! testy tworzą i usuwają dane)
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/ventida_test"
